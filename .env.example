NODE_ENV=development
LOG_LEVEL=debug

# Application ports and origins are reserved for scaffolding.
API_PORT=4000
STUDENT_PORT=3000
RESTAURANT_PORT=3001
ADMIN_PORT=3002
API_URL=http://localhost:4000
STUDENT_URL=http://localhost:3000
RESTAURANT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local infrastructure. Replace the sample password in both fields.
POSTGRES_USER=umfood
POSTGRES_PASSWORD=replace_me_for_local_dev
POSTGRES_DB=umfood_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://umfood:replace_me_for_local_dev@127.0.0.1:5432/umfood_dev
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Future authentication. Provider selection is open.
AUTH_PROVIDER=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Future Telegram Bot API integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Future S3-compatible storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Future external integrations.
MAPS_API_KEY=
PUSH_PROVIDER=
ERROR_MONITORING_DSN=
PAYMENT_PROVIDER=
