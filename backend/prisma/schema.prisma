// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  OWNER
  STAFF
  ADMIN
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PricingModel {
  FIXED
  MEASURED
}

enum PaymentMethod {
  CASH
  QR
  ACCOUNT_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  name                String
  role                UserRole @default(STUDENT)
  isActive            Boolean  @default(true)
  needsPasswordChange Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hostel String? // Metadata for students

  restaurant  Restaurant? // If role is OWNER
  staffBranch StaffBranch? // If role is STAFF
  orders      Order[]
  favorites   Favorite[]
}

model Restaurant {
  id        String     @id @default(uuid())
  name      String
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  branches  Branch[]
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Branch {
  id           String     @id @default(uuid())
  name         String
  address      String
  latitude     Float?
  longitude    Float?
  hostelTags   String[] // Array of hostel names served
  openingHours Json? // Structured opening hours
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  staffMembers    StaffBranch[]
  branchMenuItems BranchMenuItem[]
  branchVariants  BranchMenuItemVariant[]
  orders          Order[]
  paymentOptions  BranchPaymentOption[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model BranchPaymentOption {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  isEnabled Boolean       @default(true)

  // QR configuration
  qrCodeImageUrl String?

  // Account Transfer configuration
  bankName          String?
  accountNumber     String?
  accountHolderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, method])
}

model StaffBranch {
  id       String @id @default(uuid())
  staffId  String @unique
  staff    User   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  assignedAt DateTime @default(now())
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  menuItems MenuItem[] @relation("MenuItemCategories")
}

model MenuItem {
  id              String  @id @default(uuid())
  name            String
  description     String?
  photo           String? // Cloudinary URL
  isActive        Boolean @default(true)
  isVeg           Boolean @default(false)
  isSpicy         Boolean @default(false)
  preparationTime Int? // in minutes

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  categories   Category[] @relation("MenuItemCategories")

  variants    MenuItemVariant[]
  branchItems BranchMenuItem[]
  orderItems  OrderItem[]
  favorites   Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name String // e.g., "Half", "Full", "Small", "Regular"

  unitType  VariantUnitType @default(portion)
  unitValue Float? // e.g., 100, 500, 1
  unitLabel String? // g, ml, piece, plate, bowl

  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)

  branchVariants BranchMenuItemVariant[]
  orderItems     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VariantUnitType {
  portion
  size
  weight
  volume
  unit
}

model BranchMenuItemVariant {
  id                String          @id @default(uuid())
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id])
  menuItemVariantId String
  menuItemVariant   MenuItemVariant @relation(fields: [menuItemVariantId], references: [id], onDelete: Cascade)

  price       Decimal? @db.Decimal(10, 2) // Override price
  isAvailable Boolean  @default(true) // Override availability

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, menuItemVariantId])
}

model BranchMenuItem {
  id         String   @id @default(uuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  isAvailable Boolean @default(true)
  stockLimit  Int? // Optional stock limit

  // Overrides (if any)
  priceOverride       Decimal? @db.Decimal(10, 2)
  isAvailableOverride Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, menuItemId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, menuItemId])
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // Human readable short id
  status      OrderStatus @default(PLACED)

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  totalPrice    Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)

  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  paymentProofs PaymentProof[]

  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  variantId String?
  variant   MenuItemVariant? @relation(fields: [variantId], references: [id])

  quantity  Float   @default(1) // Can be float for measured items if needed, but usually 1 order item = 1 menu item entry
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  // For measured items, staff will update this
  finalQuantity Float?
  isMeasured    Boolean @default(false)
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  staffId   String? // Who changed the status
  createdAt DateTime    @default(now())
}

model PaymentProof {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  imageUrl  String
  createdAt DateTime @default(now())
}
